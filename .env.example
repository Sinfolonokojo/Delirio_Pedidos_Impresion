# Choose a private code (at least 6 characters); share it only with your staff.
STAFF_PIN=replace-with-your-team-code
PORT=4173
# Loopback is the safe local-preview default. Set 0.0.0.0 for LAN access.
HOST=127.0.0.1
DATA_FILE=data/orders.sqlite
# Set true behind HTTPS. PUBLIC_ORIGIN must equal the external origin, no trailing slash.
COOKIE_SECURE=false
# PUBLIC_ORIGIN=https://pedidos.example.com

# Leave blank until LAN setup is verified. No historical preview tickets are auto-sent.
PRINTER_HOST=
# Raw TCP ESC/POS defaults; verify these against the printer configuration.
PRINTER_PORT=9100
PRINTER_COLUMNS=42
PRINTER_CUT=true
PRINTER_TIMEOUT_MS=5000
